# Exemplo de variaveis exigidas por docker-compose.release-qualification.yml -
# NUNCA preenchido com valores reais neste repositorio. O workflow de
# release-qualification gera cada valor de credencial de forma efemera em
# tempo de execucao (ex.: "openssl rand -hex 16"), nunca reaproveitando um
# valor commitado - credenciais desta stack efemera nunca sobrevivem alem
# da execucao do job que as gerou.

# --- Identidade das imagens (campo "image" de cada componente em
# artifacts/sbom/images.json, produzido pelo MESMO job de build once -
# tag LOCAL, nunca uma referencia de registry remoto, nunca "latest") ---
LEDGER_API_IMAGE_REF=
LEDGER_OUTBOX_PUBLISHER_IMAGE_REF=
CONSOLIDATION_API_IMAGE_REF=
CONSOLIDATION_WORKER_IMAGE_REF=

# --- Credenciais efemeras (geradas pelo workflow, nunca reaproveitadas) ---
LEDGER_MIGRATION_PASSWORD=
LEDGER_API_PASSWORD=
LEDGER_OUTBOX_PUBLISHER_PASSWORD=
CONSOLIDATION_MIGRATION_PASSWORD=
CONSOLIDATION_WORKER_PASSWORD=
CONSOLIDATION_API_READONLY_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_CLIENT_ID=
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET=

# --- Certificados TLS efemeros (gerados pelo workflow para o runner,
# nunca os mesmos certificados de desenvolvimento local) ---
RELEASE_TLS_CA_PATH=
RELEASE_TLS_CERT_PATH=
RELEASE_TLS_KEY_PATH=
